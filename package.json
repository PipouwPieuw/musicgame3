{
  "name": "advency-sound-system",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "sass scss/main.scss style.css --style=compressed --no-source-map",
    "watch": "sass scss/main.scss style.css --style=compressed --no-source-map --watch",
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "import-players": "node server/scripts/import-players-json.js",
    "optimize-covers": "node scripts/optimize-covers.js"
  },
  "dependencies": {
    "24": "^0.0.0",
    "@supabase/supabase-js": "^2.110.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "sass": "1.69.7",
    "sharp": "^0.34.4"
  }
}
